{
  "name": "@ayepi/mcp",
  "version": "0.5.0",
  "description": "Model Context Protocol server for @ayepi/core — expose any ayepi spec as schema-validated MCP tools, executed against your app",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ClickerMonkey/ayepi.git",
    "directory": "packages/mcp"
  },
  "homepage": "https://github.com/ClickerMonkey/ayepi/tree/main/packages/mcp#readme",
  "bugs": {
    "url": "https://github.com/ClickerMonkey/ayepi/issues"
  },
  "type": "module",
  "sideEffects": false,
  "files": ["dist", "ayepi-*.md"],
  "exports": {
    ".": {
      "import": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
      "require": { "types": "./dist/index.d.cts", "default": "./dist/index.cjs" }
    },
    "./node": {
      "import": { "types": "./dist/node.d.ts", "default": "./dist/node.js" },
      "require": { "types": "./dist/node.d.cts", "default": "./dist/node.cjs" }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage",
    "publint": "publint"
  },
  "engines": {
    "node": ">=18"
  },
  "peerDependencies": {
    "@ayepi/auth": "workspace:^",
    "@ayepi/core": "workspace:^",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@ayepi/auth": "workspace:*",
    "@ayepi/core": "workspace:*",
    "@vitest/coverage-v8": "^2.1.8",
    "publint": "^0.3.0",
    "tsdown": "^0.12.0",
    "vitest": "^2.1.8",
    "zod": "^4.6.7"
  },
  "keywords": ["ayepi", "mcp", "model-context-protocol", "ai", "tools", "llm"]
}
